# Production shape only. Populate through the production secret manager, never this file.
NODE_ENV=production
DEPLOYMENT_ENVIRONMENT=production
DATABASE_URL=postgresql://PRODUCTION_SECRET_MANAGER_VALUE@production-db.example.internal:5432/waflo?sslmode=require&schema=public
DATABASE_POOL_MAX=10
DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_MAX_LIFETIME_SECONDS=1800
REDIS_URL=rediss://PRODUCTION_SECRET_MANAGER_VALUE@production-redis.example.internal:6379
TRUSTED_PROXIES=PRODUCTION_PROXY_CIDR
RATE_LIMIT_NAMESPACE=waflo-production
MARKETING_WEB_URL=https://waflo.app
MERCHANT_DASHBOARD_URL=https://app.waflo.app
CUSTOMER_WEB_URL=https://card.waflo.app
API_PUBLIC_URL=https://api.waflo.app
ALLOWED_ORIGINS=https://waflo.app,https://www.waflo.app,https://app.waflo.app,https://card.waflo.app
NEXT_PUBLIC_API_URL=https://api.waflo.app
NEXT_PUBLIC_DASHBOARD_URL=https://app.waflo.app
NEXT_PUBLIC_MARKETING_URL=https://waflo.app
NEXT_PUBLIC_LEGAL_EFFECTIVE_DATE=LEGAL_REVIEW_REQUIRED
COOKIE_SECURE=true
COOKIE_SAME_SITE=LAX
COOKIE_NAME=__Host-waflo_session
CUSTOMER_COOKIE_NAME=__Host-waflo_customer
SESSION_IDLE_TTL_MINUTES=1440
TEST_STAFF_CLIENT_ENABLED=false

OBJECT_STORAGE_ENDPOINT=https://production-storage.example.com
OBJECT_STORAGE_REGION=PRODUCTION_REGION
OBJECT_STORAGE_BUCKET=waflo-production-private
OBJECT_STORAGE_ACCESS_KEY_ID=SECRET_MANAGER_VALUE
OBJECT_STORAGE_SECRET_ACCESS_KEY=SECRET_MANAGER_VALUE
OBJECT_STORAGE_SIGNING_SECRET=SECRET_MANAGER_VALUE
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_ALLOW_INSECURE_INTERNAL=false
SMTP_HOST=PRODUCTION_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=SECRET_MANAGER_VALUE
SMTP_PASSWORD=SECRET_MANAGER_VALUE
SMTP_FROM=Waflo <hello@waflo.app>

OAUTH_FLOW_SECRET=SECRET_MANAGER_VALUE
GOOGLE_SIGNIN_CLIENT_ID=
