# Copy values from a secret manager into the runtime environment. Never commit a populated file.
NODE_ENV=production
DEPLOYMENT_ENVIRONMENT=staging
API_PORT=4000
DATABASE_URL=postgresql://STAGING_USER:STAGING_PASSWORD@staging-db.example.internal:5432/waflo_staging?sslmode=require&schema=public
DATABASE_POOL_MAX=10
DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_MAX_LIFETIME_SECONDS=1800
REDIS_URL=rediss://STAGING_REDIS_CREDENTIALS@staging-redis.example.internal:6379
TRUSTED_PROXIES=STAGING_PROXY_CIDR
RATE_LIMIT_NAMESPACE=waflo-staging

MARKETING_WEB_URL=https://waflo.app
MERCHANT_DASHBOARD_URL=https://app.staging.waflo.app
CUSTOMER_WEB_URL=https://card.staging.waflo.app
API_PUBLIC_URL=https://api.staging.waflo.app
ALLOWED_ORIGINS=https://app.staging.waflo.app,https://card.staging.waflo.app
LEGAL_EFFECTIVE_DATE=
NEXT_PUBLIC_API_URL=https://api.staging.waflo.app
NEXT_PUBLIC_DASHBOARD_URL=https://app.staging.waflo.app
NEXT_PUBLIC_MARKETING_URL=https://waflo.app
COOKIE_SECURE=true
COOKIE_SAME_SITE=LAX
COOKIE_NAME=__Host-waflo_session
CUSTOMER_COOKIE_NAME=__Host-waflo_customer
SESSION_TTL_DAYS=30
SESSION_IDLE_TTL_MINUTES=1440

OBJECT_STORAGE_ENDPOINT=https://staging-storage.example.com
OBJECT_STORAGE_REGION=STAGING_REGION
OBJECT_STORAGE_BUCKET=waflo-staging-private
OBJECT_STORAGE_ACCESS_KEY_ID=SECRET_MANAGER_VALUE
OBJECT_STORAGE_SECRET_ACCESS_KEY=SECRET_MANAGER_VALUE
OBJECT_STORAGE_SIGNING_SECRET=SECRET_MANAGER_VALUE_AT_LEAST_32_BYTES
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_ALLOW_INSECURE_INTERNAL=false

SMTP_HOST=STAGING_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=SECRET_MANAGER_VALUE
SMTP_PASSWORD=SECRET_MANAGER_VALUE
SMTP_FROM=Waflo Staging <staging@waflo.app>

OAUTH_FLOW_SECRET=SECRET_MANAGER_VALUE_AT_LEAST_32_BYTES
GOOGLE_SIGNIN_CLIENT_ID=
GOOGLE_SIGNIN_CLIENT_SECRET=
# Expected when enabled: https://api.staging.waflo.app/v1/auth/external/google/callback
GOOGLE_SIGNIN_REDIRECT_URI=
APPLE_SIGNIN_CLIENT_ID=
APPLE_SIGNIN_TEAM_ID=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_PRIVATE_KEY_BASE64=
# Expected when enabled: https://api.staging.waflo.app/v1/auth/external/apple/callback
APPLE_SIGNIN_REDIRECT_URI=

CUSTOMER_DATA_ENCRYPTION_KEYS_JSON={"1":"SECRET_MANAGER_VALUE"}
CUSTOMER_DATA_ACTIVE_KEY_VERSION=1
CUSTOMER_CONTACT_LOOKUP_HMAC_KEY=SECRET_MANAGER_VALUE
CUSTOMER_SESSION_SECRET=SECRET_MANAGER_VALUE
MEMBERSHIP_CREDENTIAL_SECRETS_JSON={"1":"SECRET_MANAGER_VALUE"}
MEMBERSHIP_CREDENTIAL_ACTIVE_SECRET_VERSION=1
APPLE_PASS_AUTH_SECRETS_JSON={"1":"SECRET_MANAGER_VALUE"}
APPLE_PASS_AUTH_ACTIVE_SECRET_VERSION=1
CUSTOMER_DATA_ENCRYPTION_KEY_V1=SECRET_MANAGER_VALUE
MEMBERSHIP_CREDENTIAL_SECRET_V1=SECRET_MANAGER_VALUE
APPLE_PASS_AUTH_SECRET_V1=SECRET_MANAGER_VALUE
LEDGER_HASH_SECRET_V1=SECRET_MANAGER_VALUE
MERCHANT_TRANSACTION_REFERENCE_HMAC_KEY_V1=SECRET_MANAGER_VALUE
DEVICE_SESSION_SECRET=SECRET_MANAGER_VALUE
TEST_STAFF_CLIENT_ENABLED=false

STRIPE_SECRET_KEY=sk_test_SECRET_MANAGER_VALUE
STRIPE_PUBLISHABLE_KEY=pk_test_PUBLIC_VALUE
STRIPE_WEBHOOK_SECRET=whsec_SECRET_MANAGER_VALUE
STRIPE_STARTER_MONTHLY_PRICE_ID=price_STAGING_STARTER
STRIPE_GROWTH_MONTHLY_PRICE_ID=price_STAGING_GROWTH
STRIPE_SCALE_MONTHLY_PRICE_ID=price_STAGING_SCALE
STRIPE_CUSTOMER_PORTAL_CONFIGURATION_ID=bpc_STAGING
STRIPE_RECONCILIATION_INTERVAL_MINUTES=60
STRIPE_RECONCILIATION_BATCH_SIZE=50

GOOGLE_WALLET_MODE=DISABLED
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON_PATH_OR_BASE64=
GOOGLE_WALLET_ALLOWED_ORIGINS=https://card.staging.waflo.app
GOOGLE_WALLET_PUBLIC_ASSET_BASE_URL=https://api.staging.waflo.app/v1/public/wallet-assets
GOOGLE_WALLET_PUBLISHING_MODE=DEMO
APPLE_WALLET_MODE=DISABLED
APPLE_PASS_TYPE_IDENTIFIER=
APPLE_TEAM_IDENTIFIER=
APPLE_PASS_CERTIFICATE_PATH_OR_BASE64=
APPLE_PASS_CERTIFICATE_PASSWORD=
APPLE_WWDR_CERTIFICATE_PATH_OR_BASE64=
APPLE_PASS_WEB_SERVICE_URL=https://api.staging.waflo.app/v1/apple-wallet
APPLE_APNS_ENVIRONMENT=sandbox
WALLET_PUBLIC_BASE_URL=https://api.staging.waflo.app/v1/public/wallet-assets

WORKER_HEARTBEAT_INTERVAL_SECONDS=30
WORKER_DEGRADED_AFTER_SECONDS=120
CLEANUP_BATCH_SIZE=500
SECURITY_TOKEN_RETENTION_DAYS=30
WALLET_WORKER_CONCURRENCY=4
WALLET_COMMAND_MAX_ATTEMPTS=8
SENTRY_DSN=
LOG_LEVEL=info
