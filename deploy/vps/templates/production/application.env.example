# NON-SENSITIVE runtime configuration. Copy to:
# /opt/waflo-platform/env/production/application.env
NODE_ENV=production
DEPLOYMENT_ENVIRONMENT=production
API_PORT=4000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_MAX_LIFETIME_SECONDS=1800
RATE_LIMIT_NAMESPACE=waflo-production
TRUSTED_PROXIES=10.210.20.0/24

MARKETING_WEB_URL=https://waflo.app
MERCHANT_DASHBOARD_URL=https://app.waflo.app
CUSTOMER_WEB_URL=https://card.waflo.app
API_PUBLIC_URL=https://api.waflo.app
ALLOWED_ORIGINS=https://waflo.app,https://www.waflo.app,https://app.waflo.app,https://card.waflo.app
COOKIE_SECURE=true
COOKIE_SAME_SITE=LAX
COOKIE_NAME=__Host-waflo_session
CUSTOMER_COOKIE_NAME=__Host-waflo_customer
SESSION_TTL_DAYS=30
SESSION_IDLE_TTL_MINUTES=1440
CUSTOMER_SESSION_TTL_DAYS=90

OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=waflo-production-private
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_ALLOW_INSECURE_INTERNAL=true

SMTP_HOST=mail.waflo.app
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM=Waflo <hello@waflo.app>
EMAIL_FROM=Waflo <hello@waflo.app>

GOOGLE_SIGNIN_CLIENT_ID=
GOOGLE_SIGNIN_REDIRECT_URI=
APPLE_SIGNIN_CLIENT_ID=
APPLE_SIGNIN_TEAM_ID=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_REDIRECT_URI=
MERCHANT_BASE_DOMAIN=waflo.app

STRIPE_PUBLISHABLE_KEY=
STRIPE_STARTER_MONTHLY_PRICE_ID=
STRIPE_GROWTH_MONTHLY_PRICE_ID=
STRIPE_SCALE_MONTHLY_PRICE_ID=
STRIPE_CUSTOMER_PORTAL_CONFIGURATION_ID=
STRIPE_RECONCILIATION_INTERVAL_MINUTES=60
STRIPE_RECONCILIATION_BATCH_SIZE=50

GOOGLE_WALLET_MODE=DISABLED
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_ALLOWED_ORIGINS=https://card.waflo.app
GOOGLE_WALLET_PUBLIC_ASSET_BASE_URL=https://api.waflo.app/v1/public/wallet-assets
GOOGLE_WALLET_PUBLISHING_MODE=PUBLISHING
APPLE_WALLET_MODE=DISABLED
APPLE_PASS_TYPE_IDENTIFIER=
APPLE_TEAM_IDENTIFIER=
APPLE_ORGANIZATION_NAME=Waflo by Tavrix LLC
APPLE_PASS_WEB_SERVICE_URL=https://api.waflo.app/v1/apple-wallet
APPLE_APNS_ENVIRONMENT=production
WALLET_PUBLIC_BASE_URL=https://api.waflo.app/v1/public/wallet-assets

TEST_STAFF_CLIENT_ENABLED=false
WALLET_WORKER_CONCURRENCY=4
WALLET_COMMAND_MAX_ATTEMPTS=8
WORKER_HEARTBEAT_INTERVAL_SECONDS=30
WORKER_DEGRADED_AFTER_SECONDS=120
CLEANUP_BATCH_SIZE=500
SECURITY_TOKEN_RETENTION_DAYS=30
LOG_LEVEL=info
