# Non-sensitive Compose interpolation. Copy to:
# /opt/waflo-platform/env/production/compose.env
PLATFORM_ROOT=/opt/waflo-platform
IMAGE_REGISTRY=ghcr.io/REPLACE_WITH_OWNER
POSTGRES_DB=waflo_production
POSTGRES_USER=waflo_production
POSTGRES_MAX_CONNECTIONS=100
OBJECT_STORAGE_BUCKET=waflo-production-private
WAFLO_EDGE_SUBNET=10.210.20.0/24
WAFLO_BACKEND_SUBNET=10.210.21.0/24
NEXT_PUBLIC_API_URL=https://api.waflo.app
NEXT_PUBLIC_DASHBOARD_URL=https://app.waflo.app
NEXT_PUBLIC_MARKETING_URL=https://waflo.app
# Public browser token only. Restrict it to https://app.waflo.app and minimum map/search read scopes.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
API_DATABASE_POOL_MAX=10
OPERATIONAL_WORKER_DATABASE_POOL_MAX=5
WALLET_WORKER_DATABASE_POOL_MAX=5
REDIS_MAXMEMORY=192mb
POSTGRES_SHARED_BUFFERS=384MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
POSTGRES_MAINTENANCE_WORK_MEM=64MB
POSTGRES_WORK_MEM=4MB
POSTGRES_MEMORY_LIMIT=1280m
POSTGRES_CPU_LIMIT=1.50
REDIS_MEMORY_LIMIT=256m
REDIS_CPU_LIMIT=0.35
OBJECT_STORAGE_MEMORY_LIMIT=512m
OBJECT_STORAGE_CPU_LIMIT=0.60
API_MEMORY_LIMIT=640m
API_CPU_LIMIT=1.00
MERCHANT_MEMORY_LIMIT=288m
MERCHANT_CPU_LIMIT=0.50
CUSTOMER_MEMORY_LIMIT=288m
CUSTOMER_CPU_LIMIT=0.50
MARKETING_MEMORY_LIMIT=256m
MARKETING_CPU_LIMIT=0.40
OPERATIONAL_WORKER_MEMORY_LIMIT=512m
OPERATIONAL_WORKER_CPU_LIMIT=0.60
WALLET_WORKER_MEMORY_LIMIT=640m
WALLET_WORKER_CPU_LIMIT=0.80
CLOUDFLARED_MEMORY_LIMIT=128m
CLOUDFLARED_CPU_LIMIT=0.20
