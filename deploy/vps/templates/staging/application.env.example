# NON-SENSITIVE runtime configuration. Copy to:
# /opt/waflo-platform/env/staging/application.env
NODE_ENV=production
DEPLOYMENT_ENVIRONMENT=staging
API_PORT=4000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_MAX_LIFETIME_SECONDS=1800
RATE_LIMIT_NAMESPACE=waflo-staging
TRUSTED_PROXIES=10.210.10.0/24

MARKETING_WEB_URL=https://staging.waflo.app
MERCHANT_DASHBOARD_URL=https://app-staging.waflo.app
CUSTOMER_WEB_URL=https://card-staging.waflo.app
API_PUBLIC_URL=https://api-staging.waflo.app
# Required non-secret public contact mailbox; install a verified receiving address.
SUPPORT_EMAIL=
# Leave empty until Privacy/Terms legal approval; Marketing renders its draft-review notice.
LEGAL_EFFECTIVE_DATE=
ALLOWED_ORIGINS=https://staging.waflo.app,https://app-staging.waflo.app,https://card-staging.waflo.app
COOKIE_SECURE=true
COOKIE_SAME_SITE=LAX
COOKIE_NAME=__Host-waflo_session
CUSTOMER_COOKIE_NAME=__Host-waflo_customer
SESSION_TTL_DAYS=30
SESSION_IDLE_TTL_MINUTES=1440
CUSTOMER_SESSION_TTL_DAYS=90

OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=waflo-staging-private
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_ALLOW_INSECURE_INTERNAL=true

SMTP_HOST=mail.waflo.app
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM=Waflo Staging <staging@waflo.app>
EMAIL_FROM=Waflo Staging <staging@waflo.app>

GOOGLE_SIGNIN_CLIENT_ID=
# When Google Sign-In is enabled, set exactly:
# https://api-staging.waflo.app/v1/auth/external/google/callback
GOOGLE_SIGNIN_REDIRECT_URI=
APPLE_SIGNIN_CLIENT_ID=
APPLE_SIGNIN_TEAM_ID=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_REDIRECT_URI=
EXTERNAL_AUTH_TOKEN_ACTIVE_KEY_VERSION=1
MERCHANT_BASE_DOMAIN=waflo.app

STRIPE_PUBLISHABLE_KEY=pk_test_PUBLIC_VALUE
STRIPE_STARTER_MONTHLY_PRICE_ID=
STRIPE_GROWTH_MONTHLY_PRICE_ID=
STRIPE_SCALE_MONTHLY_PRICE_ID=
STRIPE_STARTER_QUARTERLY_PRICE_ID=
STRIPE_GROWTH_QUARTERLY_PRICE_ID=
STRIPE_SCALE_QUARTERLY_PRICE_ID=
STRIPE_STARTER_YEARLY_PRICE_ID=
STRIPE_GROWTH_YEARLY_PRICE_ID=
STRIPE_SCALE_YEARLY_PRICE_ID=
STRIPE_CUSTOMER_PORTAL_CONFIGURATION_ID=
STRIPE_RECONCILIATION_INTERVAL_MINUTES=60
STRIPE_RECONCILIATION_BATCH_SIZE=50

GOOGLE_WALLET_MODE=REAL
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON_PATH_OR_BASE64=/run/waflo-provider-secrets/google-wallet-service-account.json
GOOGLE_WALLET_ALLOWED_ORIGINS=https://card-staging.waflo.app
GOOGLE_WALLET_PUBLIC_ASSET_BASE_URL=https://api-staging.waflo.app/v1/public/wallet-assets
GOOGLE_WALLET_PUBLISHING_MODE=DEMO
APPLE_WALLET_MODE=REAL
APPLE_PASS_TYPE_IDENTIFIER=
APPLE_TEAM_IDENTIFIER=
APPLE_ORGANIZATION_NAME=Waflo by Tavrix LLC
APPLE_PASS_CERTIFICATE_PATH_OR_BASE64=/run/waflo-provider-secrets/apple-wallet-pass.p12
APPLE_WWDR_CERTIFICATE_PATH_OR_BASE64=/run/waflo-provider-secrets/apple-wwdr.pem
APPLE_PASS_WEB_SERVICE_URL=https://api-staging.waflo.app/v1/apple-wallet
APPLE_APNS_ENVIRONMENT=production
APPLE_PASS_AUTH_ACTIVE_SECRET_VERSION=1
WALLET_PUBLIC_BASE_URL=https://api-staging.waflo.app/v1/public/wallet-assets

TEST_STAFF_CLIENT_ENABLED=false
WALLET_WORKER_CONCURRENCY=4
WALLET_COMMAND_MAX_ATTEMPTS=8
WORKER_HEARTBEAT_INTERVAL_SECONDS=30
WORKER_DEGRADED_AFTER_SECONDS=120
CLEANUP_BATCH_SIZE=500
SECURITY_TOKEN_RETENTION_DAYS=30
LOG_LEVEL=info
