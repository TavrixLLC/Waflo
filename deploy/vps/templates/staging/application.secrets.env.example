# SECRET VALUES. Copy to /opt/waflo-platform/secrets/staging/application.env,
# replace every CHANGEME, chmod 0600, and never commit the populated file.
DATABASE_URL=postgresql://waflo_staging:CHANGEME_URL_ENCODED_DB_PASSWORD@postgres:5432/waflo_staging?schema=public
REDIS_URL=redis://:CHANGEME_URL_ENCODED_REDIS_PASSWORD@redis:6379/0
OBJECT_STORAGE_ACCESS_KEY_ID=CHANGEME_MATCH_object_storage_access_key_FILE
OBJECT_STORAGE_SECRET_ACCESS_KEY=CHANGEME_MATCH_object_storage_secret_key_FILE
OBJECT_STORAGE_SIGNING_SECRET=CHANGEME_RANDOM_32_BYTES_OR_MORE
SMTP_USER=CHANGEME
SMTP_PASSWORD=CHANGEME
OAUTH_FLOW_SECRET=CHANGEME_RANDOM_32_BYTES_OR_MORE
GOOGLE_SIGNIN_CLIENT_SECRET=
APPLE_SIGNIN_PRIVATE_KEY_BASE64=
CUSTOMER_DATA_ENCRYPTION_KEYS_JSON={"1":"CHANGEME_RANDOM_32_BYTES_OR_MORE"}
CUSTOMER_DATA_ACTIVE_KEY_VERSION=1
CUSTOMER_DATA_ENCRYPTION_KEY_V1=CHANGEME_SAME_AS_VERSION_1
CUSTOMER_CONTACT_LOOKUP_HMAC_KEY=CHANGEME_RANDOM_32_BYTES_OR_MORE
CUSTOMER_SESSION_SECRET=CHANGEME_RANDOM_32_BYTES_OR_MORE
MEMBERSHIP_CREDENTIAL_SECRETS_JSON={"1":"CHANGEME_RANDOM_32_BYTES_OR_MORE"}
MEMBERSHIP_CREDENTIAL_ACTIVE_SECRET_VERSION=1
MEMBERSHIP_CREDENTIAL_SECRET_V1=CHANGEME_SAME_AS_VERSION_1
APPLE_PASS_AUTH_SECRETS_JSON={"1":"CHANGEME_RANDOM_32_BYTES_OR_MORE"}
APPLE_PASS_AUTH_ACTIVE_SECRET_VERSION=1
APPLE_PASS_AUTH_SECRET_V1=CHANGEME_SAME_AS_VERSION_1
LEDGER_HASH_SECRET_V1=CHANGEME_RANDOM_32_BYTES_OR_MORE
MERCHANT_TRANSACTION_REFERENCE_HMAC_KEY_V1=CHANGEME_RANDOM_32_BYTES_OR_MORE
DEVICE_SESSION_SECRET=CHANGEME_RANDOM_32_BYTES_OR_MORE
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APPLE_PASS_CERTIFICATE_PATH_OR_BASE64=
APPLE_PASS_CERTIFICATE_PASSWORD=
APPLE_WWDR_CERTIFICATE_PATH_OR_BASE64=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON_PATH_OR_BASE64=
