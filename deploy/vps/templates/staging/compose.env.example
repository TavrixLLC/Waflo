# Non-sensitive Compose interpolation. Copy to:
# /opt/waflo-platform/env/staging/compose.env
PLATFORM_ROOT=/opt/waflo-platform
IMAGE_REGISTRY=ghcr.io/REPLACE_WITH_OWNER
POSTGRES_DB=waflo_staging
POSTGRES_USER=waflo_staging
POSTGRES_MAX_CONNECTIONS=100
OBJECT_STORAGE_BUCKET=waflo-staging-private
WAFLO_EDGE_SUBNET=10.210.10.0/24
WAFLO_BACKEND_SUBNET=10.210.11.0/24
NEXT_PUBLIC_API_URL=https://api-staging.waflo.app
NEXT_PUBLIC_DASHBOARD_URL=https://app-staging.waflo.app
NEXT_PUBLIC_MARKETING_URL=https://staging.waflo.app
# Public browser token only. Restrict it to https://app-staging.waflo.app and minimum map/search read scopes.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
API_DATABASE_POOL_MAX=10
OPERATIONAL_WORKER_DATABASE_POOL_MAX=5
WALLET_WORKER_DATABASE_POOL_MAX=5
REDIS_MAXMEMORY=96mb
POSTGRES_SHARED_BUFFERS=128MB
POSTGRES_EFFECTIVE_CACHE_SIZE=384MB
POSTGRES_MAINTENANCE_WORK_MEM=64MB
POSTGRES_WORK_MEM=4MB
POSTGRES_MEMORY_LIMIT=512m
POSTGRES_CPU_LIMIT=0.75
REDIS_MEMORY_LIMIT=128m
REDIS_CPU_LIMIT=0.20
OBJECT_STORAGE_MEMORY_LIMIT=256m
OBJECT_STORAGE_CPU_LIMIT=0.30
API_MEMORY_LIMIT=384m
API_CPU_LIMIT=0.60
MERCHANT_MEMORY_LIMIT=160m
MERCHANT_CPU_LIMIT=0.25
CUSTOMER_MEMORY_LIMIT=160m
CUSTOMER_CPU_LIMIT=0.25
MARKETING_MEMORY_LIMIT=144m
MARKETING_CPU_LIMIT=0.20
OPERATIONAL_WORKER_MEMORY_LIMIT=320m
OPERATIONAL_WORKER_CPU_LIMIT=0.35
WALLET_WORKER_MEMORY_LIMIT=384m
WALLET_WORKER_CPU_LIMIT=0.45
CLOUDFLARED_MEMORY_LIMIT=96m
CLOUDFLARED_CPU_LIMIT=0.15
