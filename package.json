{
  "name": "waflo",
  "version": "1.0.0",
  "private": true,
  "description": "Waflo wallet-first loyalty SaaS platform foundation",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "node --env-file=.env node_modules/turbo/bin/turbo run dev --parallel",
    "dev:api": "pnpm --filter @waflo/api dev",
    "dev:marketing": "pnpm --filter @waflo/marketing-web dev",
    "dev:dashboard": "pnpm --filter @waflo/merchant-dashboard dev",
    "dev:customer": "pnpm --filter @waflo/customer-web dev",
    "dev:wallet-worker": "pnpm --filter @waflo/wallet-worker dev",
    "dev:operational-worker": "pnpm --filter @waflo/operational-worker dev",
    "readiness:production": "pnpm --filter @waflo/api readiness",
    "env:validate:test": "tsx -e \"import { parseEnvironment } from './packages/config/src/index.ts'; parseEnvironment(process.env); console.log('test environment valid')\"",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "turbo run typecheck",
    "test:prepare": "turbo run build --filter=./packages/*",
    "test": "pnpm test:prepare && node scripts/run-isolated-vitest.mjs all",
    "test:unit": "pnpm test:prepare && node scripts/run-isolated-vitest.mjs unit",
    "test:integration": "pnpm test:prepare && node scripts/run-isolated-vitest.mjs integration",
    "test:concurrency": "pnpm test:prepare && node scripts/run-isolated-vitest.mjs concurrency",
    "test:http": "pnpm test:prepare && node scripts/run-isolated-vitest.mjs http",
    "test:failure": "pnpm test:prepare && node scripts/run-isolated-vitest.mjs failure",
    "test:w4:unit": "pnpm test:prepare && node scripts/run-isolated-vitest.mjs unit tests/unit/w4-loyalty-operations.test.ts tests/unit/w4-repair-round1.test.ts",
    "test:w4:integration": "pnpm test:prepare && node scripts/run-isolated-vitest.mjs integration tests/integration/w4-loyalty-lifecycle.test.ts tests/integration/w4-operational-domain.test.ts tests/integration/w4-incremental-analytics.test.ts",
    "test:w4:http": "pnpm test:prepare && node scripts/run-isolated-vitest.mjs http tests/http/w4-staff-operations.test.ts tests/http/w4-operational-boundary.test.ts",
    "test:w4:concurrency": "pnpm test:prepare && node scripts/run-isolated-vitest.mjs concurrency tests/concurrency/w4-loyalty-concurrency.test.ts tests/concurrency/w4-operational-races.test.ts",
    "test:w4:failure": "pnpm test:prepare && node scripts/run-isolated-vitest.mjs failure",
    "test:w4:database": "pnpm test:prepare && node scripts/run-isolated-vitest.mjs integration tests/integration/w4-database-guards.test.ts",
    "test:w4:load": "pnpm test:prepare && node scripts/run-isolated-vitest.mjs unit tests/unit/w4-loyalty-operations.test.ts -t \"rebuilds 10,000 ordered ledger events\" && node scripts/run-isolated-vitest.mjs concurrency tests/concurrency/w4-loyalty-concurrency.test.ts -t \"returns compatible success for 100 concurrent same-key stamp requests\"",
    "test:e2e": "node scripts/run-playwright.mjs chromium",
    "test:a11y": "node scripts/run-playwright.mjs accessibility",
    "test:e2e:w4": "node scripts/run-playwright.mjs w4",
    "test:a11y:w4": "node scripts/run-playwright.mjs w4-accessibility",
    "w4:test-client": "node scripts/w4-staff-test-client.mjs",
    "w4:provider-artifacts": "pnpm --filter @waflo/api build && tsx --tsconfig apps/api/tsconfig.json scripts/generate-w4-provider-artifacts.mjs",
    "w4:screenshot-evidence": "node scripts/create-w4-screenshot-evidence.mjs",
    "w4:secret-scan": "node scripts/w3-secret-scan.mjs W4",
    "w4:no-flutter": "node scripts/no-flutter-scan.mjs",
    "w4:process-cleanup": "node scripts/record-w4-process-cleanup.mjs",
    "w4:quality-gate": "node scripts/run-w4-quality-gate.mjs",
    "m2:contracts": "pnpm --filter @waflo/contracts build && node scripts/generate-m2-mobile-contracts.mjs",
    "m2:contracts:verify": "node scripts/verify-m2-mobile-contracts.mjs",
    "handoff:archive": "node scripts/create-portable-archive.mjs",
    "handoff:inspect": "node scripts/inspect-portable-archive.mjs",
    "handoff:verify": "node scripts/verify-w4-portable-archive.mjs",
    "db:generate": "pnpm --filter @waflo/database generate",
    "db:validate": "pnpm --filter @waflo/database validate",
    "db:migrate": "pnpm --filter @waflo/database migrate:dev",
    "db:migrate:deploy": "pnpm --filter @waflo/database migrate:deploy",
    "db:seed": "pnpm --filter @waflo/database seed",
    "infra:up": "docker compose up -d postgres redis mailpit minio minio-init",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@biomejs/biome": "2.5.5",
    "@playwright/test": "1.62.0",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "7.2.1",
    "@waflo/stamp-engine": "workspace:*",
    "dotenv": "17.4.2",
    "fflate": "0.8.2",
    "jose": "6.2.3",
    "sharp": "^0.35.3",
    "supertest": "7.2.2",
    "tsx": "4.23.1",
    "turbo": "2.10.7",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  }
}
