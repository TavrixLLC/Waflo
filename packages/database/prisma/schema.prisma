  termsAndConditions    String?               @map("terms_and_conditions") @db.Text
  completionMessage     String?               @map("completion_message") @db.VarChar(240)
  rewardUnlockedMessage String?               @map("reward_unlocked_message") @db.VarChar(240)
  pausedMessage         String?               @map("paused_message") @db.VarChar(240)
