  organizationId       String                     @map("organization_id") @db.Uuid
  programId            String                     @map("program_id") @db.Uuid
  action               String                     @db.VarChar(30)
  reason               String                     @db.VarChar(80)
  commandType          WalletCommandType          @map("command_type")
  idempotencyKey       String                     @unique @map("idempotency_key") @db.VarChar(255)
  status               ProgramWalletSyncJobStatus @default(PENDING)
  snapshotAt           DateTime                   @default(now()) @map("snapshot_at") @db.Timestamptz(6)
  cursorCreatedAt      DateTime?                  @map("cursor_created_at") @db.Timestamptz(6)
  cursorPassInstanceId String?                    @map("cursor_pass_instance_id") @db.Uuid
  batchSize            Int                        @default(500) @map("batch_size")
  processedCount       Int                        @default(0) @map("processed_count")
  attemptCount         Int                        @default(0) @map("attempt_count")
  leaseOwner           String?                    @map("lease_owner") @db.VarChar(120)
  leaseExpiresAt       DateTime?                  @map("lease_expires_at") @db.Timestamptz(6)
  nextAttemptAt        DateTime                   @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  safeErrorCode        String?                    @map("safe_error_code") @db.VarChar(120)
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt          DateTime?                  @map("completed_at") @db.Timestamptz(6)
  organization         Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  program              LoyaltyProgram             @relation(fields: [programId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt, leaseExpiresAt])
  @@index([organizationId, programId, createdAt])
  @@index([programId, snapshotAt, cursorCreatedAt, cursorPassInstanceId])
  @@map("program_wallet_sync_jobs")
}

