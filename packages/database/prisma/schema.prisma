model MembershipCredential {
  id                  String                     @id @default(uuid()) @db.Uuid
  organizationId      String                     @map("organization_id") @db.Uuid
  membershipId        String                     @map("membership_id") @db.Uuid
  credentialVersion   Int                        @map("credential_version")
