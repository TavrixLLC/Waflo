  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Organization {
  id                    String                   @id @default(uuid()) @db.Uuid
  name                  String                   @db.VarChar(120)
  normalizedName        String                   @map("normalized_name") @db.VarChar(120)
  merchantSlug          String                   @unique @map("merchant_slug") @db.VarChar(40)
  businessCategory      String?                  @map("business_category") @db.VarChar(80)
  defaultLocale         Locale                   @default(EN) @map("default_locale")
  timezone              String                   @db.VarChar(100)
  status                OrganizationStatus       @default(ACTIVE)
  selectedPlan          PlanCode                 @default(STARTER) @map("selected_plan")
  onboardingState       OnboardingState          @default(BUSINESS) @map("onboarding_state")
  onboardingCompletedAt DateTime?                @map("onboarding_completed_at") @db.Timestamptz(6)
  onboardingCommandId   String?                  @unique @map("onboarding_command_id") @db.Uuid
  onboardingRequestFingerprint String?           @map("onboarding_request_fingerprint") @db.Char(64)
  brandLogoAssetId      String?                  @map("brand_logo_asset_id") @db.Uuid
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt            DateTime?                @map("archived_at") @db.Timestamptz(6)
  members               OrganizationMember[]
  invitations           OrganizationInvitation[]
  locations             Location[]
  domains               OrganizationDomain[]
  slugHistory           MerchantSlugHistory[]
  billingProfile        OrganizationBillingProfile?
  subscriptions         Subscription[]
  webhookEvents         ProcessedWebhookEvent[]
  billingInvoices       BillingInvoice[]
  billingEmailOutbox    BillingEmailOutbox[]
  billingRefundRequests BillingRefundRequest[]
  auditLogs             AuditLog[]
  securityEvents        SecurityEvent[]
  checkoutIdempotencyKeys CheckoutIdempotencyKey[]
  loyaltyPrograms        LoyaltyProgram[]
  loyaltyProgramVersions LoyaltyProgramVersion[]
  merchantAssets         MerchantAsset[]
  brandLogoAsset         MerchantAsset?          @relation("OrganizationBrandLogo", fields: [brandLogoAssetId], references: [id], onDelete: Restrict)
  generatedPreviews      GeneratedProgramPreview[]
  validationRuns         ProgramValidationRun[]
  testSessions           ProgramTestSession[]
  publishCommands        ProgramPublishCommand[]
  customers              Customer[]
  customerContacts       CustomerContact[]
  customerConsents       CustomerConsent[]
  customerMemberships    Membership[]
  enrollmentPolicies     ProgramEnrollmentPolicy[]
  enrollmentCommands     EnrollmentCommand[]
  membershipProgress     MembershipProgressProjection[]
  membershipSessions     MembershipAccessSession[]
  membershipCredentials  MembershipCredential[]
  walletPassInstances    WalletPassInstance[]
  walletProgramBindings  WalletProgramBinding[]
  walletCommands         WalletCommand[]
  transferCommands       MembershipTransferCommand[]
  transferEvents         MembershipTransferEvent[]
  publicWalletAssets      PublicWalletAsset[]
  programWalletSyncJobs   ProgramWalletSyncJob[]
  walletNearbyConfiguration  WalletNearbyConfiguration?
  walletNearbyProgramCopies  WalletNearbyProgramCopy[]
  walletEngagementCampaigns WalletEngagementCampaign[]
  walletCampaignDeliveries WalletCampaignDelivery[]

  @@index([status])
  @@map("organizations")
}

model MerchantSlugHistory {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  slug           String       @db.VarChar(40)
  releasedAt     DateTime     @map("released_at") @db.Timestamptz(6)
