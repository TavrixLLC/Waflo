model User {
  id                         String                   @id @default(uuid()) @db.Uuid
  displayName                String                   @db.VarChar(100)
  email                      String                   @db.VarChar(254)
  normalizedEmail            String                   @unique @map("normalized_email") @db.VarChar(254)
  emailVerifiedAt            DateTime?                @map("email_verified_at") @db.Timestamptz(6)
  passwordHash               String?                  @map("password_hash") @db.Text
  interactiveLoginAllowed    Boolean                  @default(true) @map("interactive_login_allowed")
  preferredLocale            Locale                   @default(EN) @map("preferred_locale")
  status                     UserStatus               @default(ACTIVE)
  termsVersion               String                   @map("terms_version") @db.VarChar(60)
  privacyVersion             String                   @map("privacy_version") @db.VarChar(60)
  legalAcceptedAt            DateTime                 @map("legal_accepted_at") @db.Timestamptz(6)
  lastLoginAt                DateTime?                @map("last_login_at") @db.Timestamptz(6)
  lastSelectedOrganizationId String?                  @map("last_selected_organization_id") @db.Uuid
  createdAt                  DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  deactivatedAt              DateTime?                @map("deactivated_at") @db.Timestamptz(6)
  deletionRequestedAt        DateTime?                @map("deletion_requested_at") @db.Timestamptz(6)
  sessions                   Session[]
  externalIdentities         ExternalIdentity[]
  oauthAuthorizationRequests OAuthAuthorizationRequest[]
  verificationTokens         EmailVerificationToken[]
  passwordResetTokens        PasswordResetToken[]
  memberships                OrganizationMember[]
  invitationsSent            OrganizationInvitation[] @relation("InvitedBy")
  auditEvents                AuditLog[]                @relation("AuditActor")
  securityEvents             SecurityEvent[]
  triggeredTrials            OrganizationBillingProfile[] @relation("TrialTriggeredBy")
  createdLoyaltyPrograms     LoyaltyProgram[]           @relation("ProgramCreator")
  createdProgramVersions     LoyaltyProgramVersion[]    @relation("VersionCreator")
  createdMerchantAssets      MerchantAsset[]           @relation("AssetCreator")
  createdValidationRuns      ProgramValidationRun[]     @relation("ValidationCreator")
  createdTestSessions        ProgramTestSession[]       @relation("TestSessionCreator")
  accountLifecycleRequests   MerchantAccountLifecycleRequest[]
  createdWalletCampaigns     WalletEngagementCampaign[] @relation("WalletCampaignCreator")
  updatedWalletNearbyConfigurations WalletNearbyConfiguration[] @relation("WalletNearbyUpdater")
  updatedWalletNearbyProgramCopies  WalletNearbyProgramCopy[]  @relation("WalletNearbyProgramCopyUpdater")
  requestedBillingRefunds    BillingRefundRequest[] @relation("BillingRefundRequester")
  reviewedBillingRefunds     BillingRefundRequest[] @relation("BillingRefundReviewer")

  @@map("users")
}

model MerchantAccountLifecycleRequest {
  id                  String                       @id @default(uuid()) @db.Uuid
  userId              String                       @map("user_id") @db.Uuid
  requestType         MerchantAccountRequestType   @map("request_type")
  status              MerchantAccountRequestStatus @default(PENDING)
  idempotencyKey      String                       @map("idempotency_key") @db.VarChar(255)
  identityValidatedAt DateTime                     @map("identity_validated_at") @db.Timestamptz(6)
  requestedAt         DateTime                     @default(now()) @map("requested_at") @db.Timestamptz(6)
  completedAt         DateTime?                    @map("completed_at") @db.Timestamptz(6)
  outcomeDisposition  CustomerPrivacyDisposition? @map("outcome_disposition")
  retentionNoticeCode String?                      @map("retention_notice_code") @db.VarChar(120)
  safeFailureCode     String?                      @map("safe_failure_code") @db.VarChar(120)
  user                User                         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, idempotencyKey])
  @@index([status, requestedAt])
  @@map("merchant_account_lifecycle_requests")
}

model ExternalIdentity {
  id                     String                        @id @default(uuid()) @db.Uuid
  provider               ExternalIdentityProvider
  issuer                 String                        @db.VarChar(255)
  providerSubject        String                        @map("provider_subject") @db.VarChar(255)
  userId                 String                        @map("user_id") @db.Uuid
  providerEmail          String?                       @map("provider_email") @db.VarChar(254)
  emailVerified          Boolean                       @default(false) @map("email_verified")
  emailForwardingEnabled Boolean?                      @map("email_forwarding_enabled")
  createdAt              DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt             DateTime                      @default(now()) @map("last_used_at") @db.Timestamptz(6)
  user                   User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appleCredential        AppleAuthorizationCredential?

  @@unique([provider, issuer, providerSubject])
  @@unique([userId, provider])
  @@index([providerEmail])
  @@map("external_identities")
}

model OAuthAuthorizationRequest {
  id                       String                    @id @default(uuid()) @db.Uuid
  stateHash                String                    @unique @map("state_hash") @db.Char(64)
  provider                 ExternalIdentityProvider
  intent                   OAuthAuthorizationIntent
  userId                   String?                   @map("user_id") @db.Uuid
  reauthenticatedSessionId String?                   @map("reauthenticated_session_id") @db.Uuid
  nonceHash                String                    @map("nonce_hash") @db.Char(64)
  browserBindingHash       String                    @map("browser_binding_hash") @db.Char(64)
  codeVerifierCiphertext   String                    @map("code_verifier_ciphertext") @db.Text
  allowRegistration       Boolean                   @default(false) @map("allow_registration")
  termsVersion            String?                   @map("terms_version") @db.VarChar(60)
  privacyVersion          String?                   @map("privacy_version") @db.VarChar(60)
  legalAcceptedAt         DateTime?                 @map("legal_accepted_at") @db.Timestamptz(6)
  locale                   Locale                    @default(EN)
  expiresAt                DateTime                  @map("expires_at") @db.Timestamptz(6)
  consumedAt               DateTime?                 @map("consumed_at") @db.Timestamptz(6)
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  user                     User?                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([provider, expiresAt, consumedAt])
  @@index([userId, createdAt])
  @@index([reauthenticatedSessionId])
  @@map("oauth_authorization_requests")
}

model AppleAuthorizationCredential {
  id                       String           @id @default(uuid()) @db.Uuid
  externalIdentityId       String           @unique @map("external_identity_id") @db.Uuid
  refreshTokenEncrypted    String?          @map("refresh_token_encrypted") @db.Text
  refreshTokenKeyVersion   Int?             @map("refresh_token_key_version")
  accessTokenEncrypted     String?          @map("access_token_encrypted") @db.Text
  accessTokenKeyVersion    Int?             @map("access_token_key_version")
  accessTokenExpiresAt     DateTime?        @map("access_token_expires_at") @db.Timestamptz(6)
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  externalIdentity         ExternalIdentity @relation(fields: [externalIdentityId], references: [id], onDelete: Cascade)

  @@map("apple_authorization_credentials")
}

model AppleTokenRevocationJob {
  id                    String                     @id @default(uuid()) @db.Uuid
  idempotencyKey        String                     @unique @map("idempotency_key") @db.VarChar(255)
  encryptionContextId   String                     @map("encryption_context_id") @db.Uuid
  tokenEncrypted        String?                    @map("token_encrypted") @db.Text
  tokenKeyVersion       Int                        @map("token_key_version")
  tokenType             AppleTokenType             @map("token_type")
  reason                AppleTokenRevocationReason
  status                AppleTokenRevocationStatus @default(PENDING)
  attemptCount          Int                        @default(0) @map("attempt_count")
  nextAttemptAt         DateTime                   @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  leaseOwner            String?                    @map("lease_owner") @db.VarChar(120)
  leaseExpiresAt        DateTime?                  @map("lease_expires_at") @db.Timestamptz(6)
  lastFailureCode       String?                    @map("last_failure_code") @db.VarChar(120)
  completedAt           DateTime?                  @map("completed_at") @db.Timestamptz(6)
  tokenClearedAt        DateTime?                  @map("token_cleared_at") @db.Timestamptz(6)
  createdAt             DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, nextAttemptAt, leaseExpiresAt])
  @@map("apple_token_revocation_jobs")
}

model AppleServerNotification {
  id              String   @id @default(uuid()) @db.Uuid
  notificationId  String   @unique @map("notification_id") @db.VarChar(255)
  eventType       String   @map("event_type") @db.VarChar(40)
  providerSubject String   @map("provider_subject") @db.VarChar(255)
  eventTime       DateTime @map("event_time") @db.Timestamptz(6)
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt     DateTime @map("processed_at") @db.Timestamptz(6)

  @@index([providerSubject, eventTime])
  @@map("apple_server_notifications")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  tokenHash        String    @unique @map("token_hash") @db.Char(64)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastActiveAt     DateTime  @default(now()) @map("last_active_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revocationReason String?   @map("revocation_reason") @db.VarChar(120)
  ipMetadata       String?   @map("ip_metadata") @db.VarChar(64)
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  deviceLabel      String?   @map("device_label") @db.VarChar(100)
  rotatedFromId    String?   @map("rotated_from_id") @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, revokedAt])
  @@map("sessions")
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
