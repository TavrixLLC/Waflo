generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  EN
  AR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OnboardingState {
  BUSINESS
  LOCATION
  COMPLETE
}

enum PlanCode {
  STARTER
  GROWTH
  SCALE
}

enum BillingStatus {
  PENDING_ACTIVATION
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  SUSPENDED
  CANCELED
}

enum MemberRole {
  OWNER
  MANAGER
  STAFF
}

enum MemberStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  CANCELED
  EXPIRED
}

enum LocationStatus {
  ACTIVE
  ARCHIVED
}

enum DomainType {
  SUBDOMAIN
  CUSTOM
}

enum DomainStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum WebhookProcessingStatus {
  PROCESSING
  PROCESSED
  FAILED
  IGNORED_STALE
}

enum SecuritySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum LoyaltyProgramType {
  STAMP
}

enum LoyaltyProgramStatus {
  DRAFT
  VALIDATED
  TEST
  SCHEDULED
  PUBLISHED
  PAUSED
  ARCHIVED
  SUSPENDED
}

enum LoyaltyProgramVersionStatus {
  DRAFT
  VALIDATED
  TEST_READY
  PUBLISHED
  SUPERSEDED
  ABANDONED
}

enum ProgramEditingMode {
  QUICK
  PRO
}

enum RewardType {
  TEXT_REWARD
  FREE_ITEM
  DISCOUNT_DESCRIPTION
  CUSTOM
}

enum StampLayoutType {
  ROW
  GRID
  PATH
  RING
}

enum MerchantAssetCategory {
  LOGO
  HERO
  BACKGROUND
  STAMP_FILLED
  STAMP_EMPTY
  STAMP_MILESTONE
  GENERAL
}

enum MerchantAssetSource {
  WAFLO_LIBRARY
  MERCHANT_UPLOAD
  GENERATED_PREVIEW
}

enum MerchantAssetProcessingStatus {
  PENDING
  READY
  REJECTED
  ARCHIVED
}

enum ProgramPreviewType {
  STAMP_PROGRESS_WEB
  CUSTOMER_WEB_CARD
  APPLE_WALLET_PREVIEW
  GOOGLE_WALLET_PREVIEW
  THUMBNAIL
}

enum ProgramValidationStatus {
  PASSED
  VALID_WITH_WARNINGS
  FAILED
}

enum ProgramTestSessionStatus {
  ACTIVE
  RESET
  COMPLETED
}

enum ProgramTestEventType {
  TEST_STAMP_EARNED
  TEST_STAMP_REVERSED
  TEST_REWARD_UNLOCKED
  TEST_REWARD_RELOCKED
  TEST_REWARD_REDEEMED
  TEST_SESSION_RESET
}

enum ProgramPublishCommandStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum EmailCollectionMode {
  HIDDEN
  OPTIONAL
  REQUIRED
}

enum CustomerStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum CustomerContactType {
  EMAIL
}

enum ContactVerificationStatus {
  UNVERIFIED
  VERIFIED
}

enum CustomerConsentType {
  WAFLO_PRIVACY
  PROGRAM_TERMS
  MARKETING_EMAIL
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  REVOKED
}

enum EnrollmentCommandStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum MembershipCredentialStatus {
  ACTIVE
  TRANSFERRED
  REVOKED
  EXPIRED
}

enum WalletProviderCode {
  APPLE
  GOOGLE
}

enum WalletPassStatus {
  PENDING
  ISSUED
  ACTIVE
  UPDATE_PENDING
  INVALIDATION_PENDING
  INVALIDATED
  ERROR
}

enum WalletBindingStatus {
  PENDING
  READY
  ERROR
  DISABLED
}

enum WalletCommandType {
  ENSURE_TEMPLATE
  ISSUE
  UPDATE
  INVALIDATE
  RECONCILE
  APPLE_PUSH
}

enum WalletCommandStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DEAD_LETTER
}

enum ProgramWalletSyncJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DEAD_LETTER
}

enum MembershipTransferMethod {
  EMAIL_CONFIRMED
  QR_WITHOUT_EMAIL
}

enum MembershipTransferStatus {
  PENDING_CONFIRMATION
  PROCESSING
  COMPLETED
  EXPIRED
  CANCELED
  FAILED
}

enum MembershipTransferActorType {
  CUSTOMER
  SYSTEM
  SUPPORT
}

model User {
  id                         String                   @id @default(uuid()) @db.Uuid
  displayName                String                   @db.VarChar(100)
  email                      String                   @db.VarChar(254)
  normalizedEmail            String                   @unique @map("normalized_email") @db.VarChar(254)
  emailVerifiedAt            DateTime?                @map("email_verified_at") @db.Timestamptz(6)
  passwordHash               String                   @map("password_hash") @db.Text
  preferredLocale            Locale                   @default(EN) @map("preferred_locale")
  status                     UserStatus               @default(ACTIVE)
  termsVersion               String                   @map("terms_version") @db.VarChar(60)
  privacyVersion             String                   @map("privacy_version") @db.VarChar(60)
  legalAcceptedAt            DateTime                 @map("legal_accepted_at") @db.Timestamptz(6)
  lastLoginAt                DateTime?                @map("last_login_at") @db.Timestamptz(6)
  lastSelectedOrganizationId String?                  @map("last_selected_organization_id") @db.Uuid
  createdAt                  DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions                   Session[]
  verificationTokens         EmailVerificationToken[]
  passwordResetTokens        PasswordResetToken[]
  memberships                OrganizationMember[]
  invitationsSent            OrganizationInvitation[] @relation("InvitedBy")
  auditEvents                AuditLog[]                @relation("AuditActor")
  securityEvents             SecurityEvent[]
  triggeredTrials            OrganizationBillingProfile[] @relation("TrialTriggeredBy")
  createdLoyaltyPrograms     LoyaltyProgram[]           @relation("ProgramCreator")
  createdProgramVersions     LoyaltyProgramVersion[]    @relation("VersionCreator")
  createdMerchantAssets      MerchantAsset[]           @relation("AssetCreator")
  createdValidationRuns      ProgramValidationRun[]     @relation("ValidationCreator")
  createdTestSessions        ProgramTestSession[]       @relation("TestSessionCreator")

  @@map("users")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  tokenHash        String    @unique @map("token_hash") @db.Char(64)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastActiveAt     DateTime  @default(now()) @map("last_active_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revocationReason String?   @map("revocation_reason") @db.VarChar(120)
  ipMetadata       String?   @map("ip_metadata") @db.VarChar(64)
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  deviceLabel      String?   @map("device_label") @db.VarChar(100)
  rotatedFromId    String?   @map("rotated_from_id") @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, revokedAt])
  @@map("sessions")
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Organization {
  id                    String                   @id @default(uuid()) @db.Uuid
  name                  String                   @db.VarChar(120)
  normalizedName        String                   @map("normalized_name") @db.VarChar(120)
  merchantSlug          String                   @unique @map("merchant_slug") @db.VarChar(40)
  businessCategory      String?                  @map("business_category") @db.VarChar(80)
  defaultLocale         Locale                   @default(EN) @map("default_locale")
  timezone              String                   @db.VarChar(100)
  status                OrganizationStatus       @default(ACTIVE)
  selectedPlan          PlanCode                 @default(STARTER) @map("selected_plan")
  onboardingState       OnboardingState          @default(BUSINESS) @map("onboarding_state")
  onboardingCompletedAt DateTime?                @map("onboarding_completed_at") @db.Timestamptz(6)
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt            DateTime?                @map("archived_at") @db.Timestamptz(6)
  members               OrganizationMember[]
  invitations           OrganizationInvitation[]
  locations             Location[]
  domains               OrganizationDomain[]
  slugHistory           MerchantSlugHistory[]
  billingProfile        OrganizationBillingProfile?
  subscriptions         Subscription[]
  webhookEvents         ProcessedWebhookEvent[]
  auditLogs             AuditLog[]
  securityEvents        SecurityEvent[]
  checkoutIdempotencyKeys CheckoutIdempotencyKey[]
  loyaltyPrograms        LoyaltyProgram[]
  loyaltyProgramVersions LoyaltyProgramVersion[]
  merchantAssets         MerchantAsset[]
  generatedPreviews      GeneratedProgramPreview[]
  validationRuns         ProgramValidationRun[]
  testSessions           ProgramTestSession[]
  publishCommands        ProgramPublishCommand[]
  customers              Customer[]
  customerContacts       CustomerContact[]
  customerConsents       CustomerConsent[]
  customerMemberships    Membership[]
  enrollmentPolicies     ProgramEnrollmentPolicy[]
  enrollmentCommands     EnrollmentCommand[]
  membershipProgress     MembershipProgressProjection[]
  membershipSessions     MembershipAccessSession[]
  membershipCredentials  MembershipCredential[]
  walletPassInstances    WalletPassInstance[]
  walletProgramBindings  WalletProgramBinding[]
  walletCommands         WalletCommand[]
  transferCommands       MembershipTransferCommand[]
  transferEvents         MembershipTransferEvent[]
  publicWalletAssets      PublicWalletAsset[]
  programWalletSyncJobs   ProgramWalletSyncJob[]

  @@index([status])
  @@map("organizations")
}

model MerchantSlugHistory {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  slug           String       @db.VarChar(40)
  releasedAt     DateTime     @map("released_at") @db.Timestamptz(6)
  reservedUntil  DateTime     @map("reserved_until") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([slug, reservedUntil])
  @@index([organizationId, createdAt])
  @@map("merchant_slug_history")
}

model OrganizationMember {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           MemberRole
  status         MemberStatus @default(ACTIVE)
  joinedAt       DateTime     @default(now()) @map("joined_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status, role])
  @@map("organization_members")
}

model OrganizationInvitation {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  email           String       @db.VarChar(254)
  normalizedEmail String       @map("normalized_email") @db.VarChar(254)
  intendedRole    MemberRole   @map("intended_role")
  status          InvitationStatus @default(PENDING)
  tokenHash       String       @unique @map("token_hash") @db.Char(64)
  invitedByUserId String       @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime     @map("expires_at") @db.Timestamptz(6)
  acceptedAt      DateTime?    @map("accepted_at") @db.Timestamptz(6)
  canceledAt      DateTime?    @map("canceled_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitedBy       User         @relation("InvitedBy", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, normalizedEmail, status])
  @@index([organizationId, expiresAt])
  @@map("organization_invitations")
}

model Location {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  name           String         @db.VarChar(120)
  addressLine1   String?        @map("address_line_1") @db.VarChar(160)
  addressLine2   String?        @map("address_line_2") @db.VarChar(160)
  city           String?        @db.VarChar(100)
  region         String?        @db.VarChar(100)
  postalCode     String?        @map("postal_code") @db.VarChar(30)
  countryCode    String?        @map("country_code") @db.Char(2)
  phone          String?        @db.VarChar(30)
  timezone       String         @db.VarChar(100)
  status         LocationStatus @default(ACTIVE)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt     DateTime?      @map("archived_at") @db.Timestamptz(6)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  auditLogs      AuditLog[]
  programLocations ProgramLocation[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("locations")
}

model OrganizationDomain {
  id                   String       @id @default(uuid()) @db.Uuid
  organizationId       String       @map("organization_id") @db.Uuid
  hostname             String       @unique @db.VarChar(253)
  type                 DomainType
  status               DomainStatus @default(ACTIVE)
  isPrimary            Boolean      @default(false) @map("is_primary")
  verificationMetadata Json?        @map("verification_metadata") @db.JsonB
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@map("organization_domains")
}

model OrganizationBillingProfile {
  id                       String        @id @default(uuid()) @db.Uuid
  organizationId           String        @unique @map("organization_id") @db.Uuid
  stripeCustomerId         String?       @unique @map("stripe_customer_id") @db.VarChar(255)
  selectedPlan             PlanCode      @default(STARTER) @map("selected_plan")
  subscriptionStatus       BillingStatus @default(PENDING_ACTIVATION) @map("subscription_status")
  trialStart               DateTime?     @map("trial_start") @db.Timestamptz(6)
  trialEnd                 DateTime?     @map("trial_end") @db.Timestamptz(6)
  trialTriggeringProgramId String?       @map("trial_triggering_program_id") @db.Uuid
  trialTriggeringUserId    String?       @map("trial_triggering_user_id") @db.Uuid
  gracePeriodEnd           DateTime?     @map("grace_period_end") @db.Timestamptz(6)
  createdAt                DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization             Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  trialTriggeredBy         User?         @relation("TrialTriggeredBy", fields: [trialTriggeringUserId], references: [id], onDelete: SetNull)

  @@index([subscriptionStatus])
  @@map("organization_billing_profiles")
}

model Subscription {
  id                       String        @id @default(uuid()) @db.Uuid
  organizationId           String        @map("organization_id") @db.Uuid
  stripeSubscriptionId     String        @unique @map("stripe_subscription_id") @db.VarChar(255)
  stripePriceId            String        @map("stripe_price_id") @db.VarChar(255)
  planCode                 PlanCode      @map("plan_code")
  status                   BillingStatus
  currentPeriodStart       DateTime?     @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd         DateTime?     @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd        Boolean       @default(false) @map("cancel_at_period_end")
  canceledAt               DateTime?     @map("canceled_at") @db.Timestamptz(6)
  // Provider freshness metadata — prevents stale events from overwriting newer state
  lastAppliedStripeEventAt DateTime?     @map("last_applied_stripe_event_at") @db.Timestamptz(6)
  lastAppliedStripeEventId String?       @map("last_applied_stripe_event_id") @db.VarChar(255)
  lastProviderSyncAt       DateTime?     @map("last_provider_sync_at") @db.Timestamptz(6)
  createdAt                DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization             Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("subscriptions")
}

model ProcessedWebhookEvent {
  id              String                  @id @default(uuid()) @db.Uuid
  organizationId  String?                 @map("organization_id") @db.Uuid
  provider        String                  @db.VarChar(40)
  externalEventId String                  @map("external_event_id") @db.VarChar(255)
  eventType       String                  @map("event_type") @db.VarChar(160)
  status          WebhookProcessingStatus @default(PROCESSING)
  attemptCount    Int                     @default(1) @map("attempt_count")
  leaseExpiresAt  DateTime?               @map("lease_expires_at") @db.Timestamptz(6)
  processedAt     DateTime?               @map("processed_at") @db.Timestamptz(6)
  failureMetadata Json?                   @map("failure_metadata") @db.JsonB
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization?           @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([provider, externalEventId])
  @@index([status, createdAt])
  @@index([status, leaseExpiresAt])
  @@map("processed_webhook_events")
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  actorUserId    String?       @map("actor_user_id") @db.Uuid
  action         String        @db.VarChar(160)
  targetType     String        @map("target_type") @db.VarChar(100)
  targetId       String?       @map("target_id") @db.VarChar(255)
  locationId     String?       @map("location_id") @db.Uuid
  requestId      String        @map("request_id") @db.VarChar(100)
  metadata       Json?         @db.JsonB
  ipMetadata     String?       @map("ip_metadata") @db.VarChar(64)
  userAgent      String?       @map("user_agent") @db.VarChar(512)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor          User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  location       Location?     @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model SecurityEvent {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String?          @map("user_id") @db.Uuid
  organizationId String?          @map("organization_id") @db.Uuid
  eventType      String           @map("event_type") @db.VarChar(160)
  severity       SecuritySeverity @default(LOW)
  requestId      String           @map("request_id") @db.VarChar(100)
  metadata       Json?            @db.JsonB
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  reviewedAt     DateTime?        @map("reviewed_at") @db.Timestamptz(6)
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([severity, createdAt(sort: Desc)])
  @@map("security_events")
}

// Persists caller-provided command IDs for Stripe Checkout creation idempotency.
// Prevents duplicate sessions when the same (organizationId, planCode, idempotencyKey) is retried.
model CheckoutIdempotencyKey {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  idempotencyKey String       @map("idempotency_key") @db.VarChar(255)
  planCode       String       @map("plan_code") @db.VarChar(40)
  stripeSessionId String?     @map("stripe_session_id") @db.VarChar(255)
  stripeSessionUrl String?    @map("stripe_session_url") @db.Text
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@map("checkout_idempotency_keys")
}

model LoyaltyProgram {
  id                    String              @id @default(uuid()) @db.Uuid
  organizationId        String              @map("organization_id") @db.Uuid
  internalName          String              @map("internal_name") @db.VarChar(120)
  publicSlug            String?             @map("public_slug") @db.VarChar(50)
  programType           LoyaltyProgramType  @default(STAMP) @map("program_type")
  status                LoyaltyProgramStatus @default(DRAFT)
  currentDraftVersionId String?             @unique @map("current_draft_version_id") @db.Uuid
  currentPublishedVersionId String?         @unique @map("current_published_version_id") @db.Uuid
  latestVersionNumber   Int                 @default(1) @map("latest_version_number")
  createdByUserId       String              @map("created_by_user_id") @db.Uuid
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  publishedAt           DateTime?           @map("published_at") @db.Timestamptz(6)
  pausedAt              DateTime?           @map("paused_at") @db.Timestamptz(6)
  archivedAt            DateTime?           @map("archived_at") @db.Timestamptz(6)
  suspendedAt           DateTime?           @map("suspended_at") @db.Timestamptz(6)
  suspensionReasonCode  String?             @map("suspension_reason_code") @db.VarChar(120)
  revision              Int                 @default(1)
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
