  ruleVersion        String                  @default("w4r1-v1") @map("rule_version") @db.VarChar(40)
  deduplicationKey   String?                 @map("deduplication_key") @db.Char(64)
  deduplicationWindowStart DateTime?          @map("deduplication_window_start") @db.Timestamptz(6)
  safeEvidence       Json?                   @map("safe_evidence") @db.JsonB
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  acknowledgedByUserId String?               @map("acknowledged_by_user_id") @db.Uuid
  acknowledgedAt     DateTime?               @map("acknowledged_at") @db.Timestamptz(6)
  resolvedByUserId   String?                 @map("resolved_by_user_id") @db.Uuid
  resolutionNote     String?                 @map("resolution_note") @db.VarChar(500)
  resolvedAt         DateTime?               @map("resolved_at") @db.Timestamptz(6)

  @@index([organizationId, status, severity, createdAt(sort: Desc)])
  @@index([membershipId, createdAt(sort: Desc)])
  @@index([staffDeviceId, createdAt(sort: Desc)])
  @@unique([organizationId, deduplicationKey])
  @@map("operational_risk_signals")
}

